# Per-project Hyperstack config (place at project root as .hyperstack.env)
# These override the global ~/.config/hyperstack/config.env for this project.

# Default GPU flavor for this project. Run `hs.py flavors` to see available options.
# HYPERSTACK_FLAVOR=n3-RTX-A6000x1

# Override SSH user if the VM image uses a different default (usually ubuntu).
# HYPERSTACK_SSH_USER=ubuntu
